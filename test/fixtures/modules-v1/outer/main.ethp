variable "mixer" { type = string }
mixer = var.mixer

module "nested" {
  source = "../leaf"
  mixer = "legacy/leaf"
}

resource "contract" "token" {
  artifact = "Minimal.json"
  salt = derive
  args = []
  sender_independent = true
}

output "ready" {
  value = contracts.token.address
  after = [module.nested.ready]
}
